e-for-you AI prompt packs for working professionals.","sameAs":["https://www.facebook.com/profile.php?id=61588539059595"]},{"@type":"WebSite","@id":"https://figuremoney.com/#website","name":"FigureMoney","url":"https://figuremoney.com","description":"Personal-finance calculators that show the formula and sources behind every result.","sameAs":["https://www.facebook.com/profile.php?id=61592035468967"]}],"sameAs":["https://www.linkedin.com/in/dave-miles-webdev/"]},{"@type":"WebSite","@id":"https://modernsitebuilders.com/#website","url":"https://modernsitebuilders.com","name":"Modern Site Builders","publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://remodelcalculators.com/#website","name":"RemodelCalculators","url":"https://remodelcalculators.com","description":"Professional construction calculators for contractors and DIY remodels.","sameAs":["https://www.facebook.com/profile.php?id=61588161942173"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://rightdumpster.com/#website","name":"RightDumpster","url":"https://rightdumpster.com","description":"Weight-aware dumpster sizing calculator and rental guide.","sameAs":["https://www.facebook.com/profile.php?id=61588454787698"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://meetbackdrops.com/#website","name":"MeetBackdrops","url":"https://meetbackdrops.com","description":"Studio-quality 4K virtual backgrounds for Zoom, Teams, and Google Meet.","sameAs":["https://www.facebook.com/profile.php?id=61588330383610"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://wolfresume.com/#website","name":"WolfResume","url":"https://wolfresume.com","description":"AI resume generator engineered for ATS parsing and recruiter-ready output.","sameAs":["https://www.facebook.com/profile.php?id=61588600918064"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://promptdynamo.com/#website","name":"PromptDynamo","url":"https://promptdynamo.com","description":"Done-for-you AI prompt packs for working professionals.","sameAs":["https://www.facebook.com/profile.php?id=61588539059595"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://figuremoney.com/#website","name":"FigureMoney","url":"https://figuremoney.com","description":"Personal-finance calculators that show the formula and sources behind every result.","sameAs":["https://www.facebook.com/profile.php?id=61592035468967"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}}]}0:["6X-03Igl0yPGYem6o6cli",[[["",{"children":["blog",{"children":[["slug","behind-the-build-wolfresume","d"],{"children":["__PAGE__?{\"slug\":\"behind-the-build-wolfresume\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","behind-the-build-wolfresume","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"min-h-screen bg-white","children":[["$","$L2",null,{"id":"article-schema-behind-the-build-wolfresume","type":"application/ld+json","children":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Behind the Build: WolfResume and Why Most Resume Tools Fail at ATS\",\"description\":\"How Applicant Tracking Systems actually read resumes, why most builders ignore them, and how WolfResume was architected schema-first for ATS-compliant output.\",\"datePublished\":\"2026-04-20\",\"dateModified\":\"2026-04-20\",\"author\":{\"@type\":\"Person\",\"name\":\"David Miles\"},\"publisher\":{\"@id\":\"https://modernsitebuilders.com/#organization\"},\"image\":\"https://modernsitebuilders.com/Screenshot-wolfresume.jpg\",\"mainEntityOfPage\":\"https://modernsitebuilders.com/blog/behind-the-build-wolfresume/\",\"keywords\":\"Case Study, AI Tools\"}"}],["$","header",null,{"className":"border-b border-gray-200","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-between","children":[["$","$L3",null,{"href":"/","className":"flex items-center hover:opacity-80 transition-opacity","children":[["$","img",null,{"src":"/logo1.png","alt":"Modern Site Builders","className":"w-10 h-10 object-contain"}],["$","span",null,{"className":"ml-3 text-xl font-bold text-gray-900","children":"Modern Site Builders"}]]}],["$","$L3",null,{"href":"/#portfolio","className":"text-gray-700 hover:text-blue-600 text-sm font-semibold transition-colors","children":"Projects"}]]}]}],["$","main",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16","children":[["$","nav",null,{"className":"mb-8 text-sm text-gray-500","children":[["$","$L3",null,{"href":"/","className":"hover:text-blue-600","children":"Home"}],["$","span",null,{"className":"mx-2","children":"›"}],["$","$L3",null,{"href":"/blog/","className":"hover:text-blue-600","children":"Blog"}]]}],["$","article",null,{"children":[["$","header",null,{"className":"mb-10","children":[["$","div",null,{"className":"flex items-center gap-3 text-sm text-gray-500 mb-4","children":[["$","time",null,{"dateTime":"2026-04-20","children":"April 20, 2026"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":[8," min read"]}],[["$","span",null,{"children":"·"}],["$","span",null,{"children":"Case Study · AI Tools"}]]]}],["$","h1",null,{"className":"text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight","children":"Behind the Build: WolfResume and Why Most Resume Tools Fail at ATS"}],["$","p",null,{"className":"text-sm text-gray-500","children":["By ",["$","$L3",null,{"href":"/author/david-miles","className":"text-blue-600 hover:text-blue-800 font-medium","children":"David Miles"}]]}]]}],["$","div",null,{"className":"prose-content text-gray-800 leading-relaxed","children":[["$","p",null,{"className":"text-xl text-gray-600 mb-8 leading-relaxed","children":"The interesting thing about resume builders in 2026 is that almost none of them are designed for the system that actually reads resumes. They're built for humans — pretty templates, decorative columns, color accents — while 75% of applications get filtered by ATS software before any human sees them. WolfResume was built the opposite way: generate output that passes parsing first, present it nicely second. Here's how it works under the hood."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"The ATS problem most resume tools ignore"}],["$","p",null,{"className":"mb-4","children":"Applicant Tracking Systems are how 90%+ of Fortune 500 companies and a growing majority of mid-size employers initially filter applications. The software does three things: parse the resume into structured fields (work history, skills, education), score it against the job description's keywords, and rank candidates by match score."}],["$","p",null,{"className":"mb-4","children":"Most resume builders ship templates that parse badly:"}],["$","ul",null,{"className":"list-disc pl-6 mb-4 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Multi-column layouts"}]," — the parser reads top-to-bottom by column, scrambling the order of your work history."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Tables and text boxes"}]," — content gets read in document-source order, not visual order."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Decorative headers"}]," — section names like \"My Journey\" or \"What Drives Me\" don't match the schema (Experience, Education, Skills)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Images and icons"}]," — invisible to the parser; if your contact info is in an icon, it doesn't exist."]}]]}],["$","p",null,{"className":"mb-4","children":"The resume looks great as a PDF. Then the ATS reads it, can't extract the work history cleanly, and the candidate scores low against the job description even when they're perfectly qualified."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"WolfResume's architecture"}],["$","p",null,{"className":"mb-4","children":[["$","a",null,{"href":"https://wolfresume.com","target":"_blank","rel":"noopener","className":"text-blue-600 hover:underline","children":"WolfResume"}]," ","starts from a structured schema, not a visual template. Every resume is built as data: header, summary, work experience (with company, title, dates, location, bullets), education, skills (grouped properly), and optional sections. The output is then rendered into a single-column layout with semantic headings (\"Experience\" not \"My Journey\"), no tables, no text boxes, no decorative columns. ATS-parseable by design."]}],["$","p",null,{"className":"mb-4","children":"The AI generation layer sits on top of this schema. Instead of producing free-form prose like ChatGPT, the generator produces typed sections — a list of bullets per role, a list of skills per category, a clean header. The output is structurally correct before it's stylistically polished."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"Why this matters for keywords"}],["$","p",null,{"className":"mb-4","children":"ATS scoring is keyword-heavy. The system compares your resume's vocabulary against the job description's vocabulary and ranks the match. So WolfResume includes a role-targeting step: paste the job description, the generator weights the relevant skills and phrasing from your input, and the output naturally includes the keywords that matter without keyword-stuffing."}],["$","p",null,{"className":"mb-4","children":"This is the difference between \"I'm proficient in Python\" and \"Built and maintained Python data pipelines processing 10M+ records daily using pandas, Airflow, and PostgreSQL.\" Both are technically accurate. The second matches a job description for a data engineer. The first matches almost nothing."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"The ATS parser test"}],["$","p",null,{"className":"mb-4","children":"One of the most-used features on the site is the parser test page — upload any resume and see how an ATS would extract it. The visual output is sobering. Resumes that look polished frequently show parsing failures: dates attached to the wrong company, skill sections that come back empty, education sections truncated."}],["$","p",null,{"className":"mb-4","children":"It's also a useful trust-building tool. Telling someone \"your resume is poorly parsed\" is abstract. Showing them the parser's actual output is concrete. The conversion rate from parser test → generate-new-resume is meaningfully higher than from homepage → generate-new-resume."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"SEO via examples"}],["$","p",null,{"className":"mb-4","children":"The two biggest SEO clusters are role-specific examples (\"Software Engineer Resume Examples\", \"Nurse Resume Examples\", etc.) and skill pages (\"How to list Python on a resume\"). Both intercept searches from people who are mid-application, not just researching abstractly. High-intent traffic, high conversion rate to the generator."}],["$","p",null,{"className":"mb-4","children":"The pattern is the same one that worked for RemodelCalculators: build a deep library of utility-driven content where each piece feeds back to the main tool. Avoid generic \"career advice\" content — that's saturated and converts poorly. Stick to specific, tactical, immediately-usable content."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"Lessons for AI-assisted product sites"}],["$","p",null,{"className":"mb-4","children":"WolfResume isn't really an AI product — it's an ATS-compliance product that uses AI to draft content. That framing matters. \"AI resume builder\" is a saturated category with no defensible differentiation. \"Resume builder engineered for ATS parsing\" is a specific category where most competitors are worse than you, and the value proposition translates immediately."}],["$","p",null,{"className":"mb-4","children":["If you're building an AI tool, the question worth answering before you ship: ",["$","em",null,{"children":"what problem are you actually solving that doesn't go away when raw LLMs get cheaper?"}]," For WolfResume, the answer is structured output and parser-correctness — things that require deliberate engineering, not just a prompt."]}],["$","p",null,{"className":"mb-4","children":["I've spent a lot of time on this category building WolfResume. If you're working on something AI-adjacent and want to compare notes, ",["$","a",null,{"href":"/#contact","className":"text-blue-600 hover:underline","children":"drop me a line"}],"."]}]]}],["$","div",null,{"className":"mt-16 p-8 bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl text-center","children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"More from the workshop"}],["$","p",null,{"className":"text-gray-600 mb-6 max-w-xl mx-auto","children":"I build and operate a portfolio of niche websites and interactive tools — and write the build log behind each one. Browse the rest of the projects and notes."}],["$","$L3",null,{"href":"/#portfolio","className":"inline-block bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-3 rounded-full font-semibold hover:shadow-lg transition-shadow","children":"See the projects →"}]]}]]}],["$","section",null,{"className":"mt-20 pt-12 border-t border-gray-200","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-8","children":"More from the blog"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-8","children":[["$","$L3","behind-the-build-figuremoney",{"href":"/blog/behind-the-build-figuremoney/","className":"group","children":[["$","div",null,{"className":"text-xs text-gray-500 mb-2","children":"July 13, 2026"}],["$","h3",null,{"className":"text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2","children":"Behind the Build: FigureMoney and Ranking in a YMYL Niche"}],["$","p",null,{"className":"text-gray-600 text-sm","children":"Personal finance is the hardest niche on the internet to rank and get ad-approved in. Here is how FigureMoney — a 25-calculator suite — was built to earn trust: show every formula, cite every source, and cover paycheck taxes state by state."}]]}],["$","$L3","build-log-225-diagrams-remodelcalculators",{"href":"/blog/build-log-225-diagrams-remodelcalculators/","className":"group","children":[["$","div",null,{"className":"text-xs text-gray-500 mb-2","children":"July 8, 2026"}],["$","h3",null,{"className":"text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2","children":"Build Log: Why I Made 225 Original Diagrams for One Calculator Site"}],["$","p",null,{"className":"text-gray-600 text-sm","children":"Why I drew 225 original, labeled construction diagrams for RemodelCalculators — the EEAT case for original illustrations, and how each one doubles as a Pinterest distribution asset."}]]}]]}]]}]]}],["$","footer",null,{"className":"bg-gray-900 text-white py-12 mt-20","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center","children":[["$","$L3",null,{"href":"/","className":"inline-flex items-center justify-center mb-6","children":[["$","img",null,{"src":"/logo1.png","alt":"Modern Site Builders","className":"w-10 h-10 object-contain"}],["$","span",null,{"className":"ml-3 text-xl font-bold","children":"Modern Site Builders"}]]}],["$","p",null,{"className":"text-gray-400 mb-4","children":"Building and operating useful internet businesses in public."}],["$","p",null,{"className":"text-gray-500 text-sm mb-2","children":"© 2026 Modern Site Builders. Built by David Miles."}],["$","$L3",null,{"href":"/privacy","className":"text-gray-400 hover:text-white text-sm transition-colors inline-block","children":"Privacy Policy"}]]}]}]]}]],null],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","$L2",null,{"src":"https://www.googletagmanager.com/gtag/js?id=G-KMQNHVJ385","strategy":"afterInteractive"}],["$","$L2",null,{"id":"google-analytics","strategy":"afterInteractive","children":"\n            window.dataLayer = window.dataLayer || [];\n            function gtag(){dataLayer.push(arguments);}\n            gtag('js', new Date());\n            gtag('config', 'G-KMQNHVJ385', {\n              page_title: 'Modern Site Builders',\n              page_location: 'https://modernsitebuilders.com'\n            });\n          "}],["$","$L2",null,{"id":"structured-data","type":"application/ld+json","children":"$7"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.gstatic.com","crossOrigin":"anonymous"}]]}],["$","body",null,{"className":"antialiased","children":["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","