dernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://promptdynamo.com/#website","name":"PromptDynamo","url":"https://promptdynamo.com","description":"Done-for-you AI prompt packs for working professionals.","sameAs":["https://www.facebook.com/profile.php?id=61588539059595"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://figuremoney.com/#website","name":"FigureMoney","url":"https://figuremoney.com","description":"Personal-finance calculators that show the formula and sources behind every result.","sameAs":["https://www.facebook.com/profile.php?id=61592035468967"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}}]}0:["6X-03Igl0yPGYem6o6cli",[[["",{"children":["blog",{"children":[["slug","local-seo-checklist-2026","d"],{"children":["__PAGE__?{\"slug\":\"local-seo-checklist-2026\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","local-seo-checklist-2026","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"min-h-screen bg-white","children":[["$","$L2",null,{"id":"article-schema-local-seo-checklist-2026","type":"application/ld+json","children":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"The Local SEO Checklist for Small Businesses in 2026\",\"description\":\"Ten unglamorous fundamentals that move local businesses from page 3 to page 1 of Google — the checklist I run on every new client, in priority order.\",\"datePublished\":\"2026-04-12\",\"dateModified\":\"2026-04-12\",\"author\":{\"@type\":\"Person\",\"name\":\"David Miles\"},\"publisher\":{\"@id\":\"https://modernsitebuilders.com/#organization\"},\"image\":\"https://modernsitebuilders.com/logo1.png\",\"mainEntityOfPage\":\"https://modernsitebuilders.com/blog/local-seo-checklist-2026/\",\"keywords\":\"SEO, Local Business\"}"}],["$","header",null,{"className":"border-b border-gray-200","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-between","children":[["$","$L3",null,{"href":"/","className":"flex items-center hover:opacity-80 transition-opacity","children":[["$","img",null,{"src":"/logo1.png","alt":"Modern Site Builders","className":"w-10 h-10 object-contain"}],["$","span",null,{"className":"ml-3 text-xl font-bold text-gray-900","children":"Modern Site Builders"}]]}],["$","$L3",null,{"href":"/#portfolio","className":"text-gray-700 hover:text-blue-600 text-sm font-semibold transition-colors","children":"Projects"}]]}]}],["$","main",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16","children":[["$","nav",null,{"className":"mb-8 text-sm text-gray-500","children":[["$","$L3",null,{"href":"/","className":"hover:text-blue-600","children":"Home"}],["$","span",null,{"className":"mx-2","children":"›"}],["$","$L3",null,{"href":"/blog/","className":"hover:text-blue-600","children":"Blog"}]]}],["$","article",null,{"children":[["$","header",null,{"className":"mb-10","children":[["$","div",null,{"className":"flex items-center gap-3 text-sm text-gray-500 mb-4","children":[["$","time",null,{"dateTime":"2026-04-12","children":"April 12, 2026"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":[8," min read"]}],[["$","span",null,{"children":"·"}],["$","span",null,{"children":"SEO · Local Business"}]]]}],["$","h1",null,{"className":"text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight","children":"The Local SEO Checklist for Small Businesses in 2026"}],["$","p",null,{"className":"text-sm text-gray-500","children":["By ",["$","$L3",null,{"href":"/author/david-miles","className":"text-blue-600 hover:text-blue-800 font-medium","children":"David Miles"}]]}]]}],["$","div",null,{"className":"prose-content text-gray-800 leading-relaxed","children":[["$","p",null,{"className":"text-xl text-gray-600 mb-8 leading-relaxed","children":"Most local businesses I work with are leaving free leads on the table because they haven't done the boring parts of local SEO. Not the trendy parts — not \"should we be on TikTok\" or \"do we need AI content\" — the unglamorous fundamentals that move you from page 3 to page 1 of Google for the searches your customers are actually doing. Here's the checklist I run on every new client engagement."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"1. Claim and complete your Google Business Profile"}],["$","p",null,{"className":"mb-4","children":["This is the single biggest local SEO lever. If you haven't claimed your Google Business Profile (formerly Google My Business) at ",["$","a",null,{"href":"https://business.google.com","target":"_blank","rel":"noopener","className":"text-blue-600 hover:underline","children":"business.google.com"}],", do that today. Complete every field — primary category, all relevant secondary categories, service areas, hours, attributes, photos, products, services."]}],["$","p",null,{"className":"mb-4","children":"The map pack (the top three local results that show up with a map) is largely driven by your Google Business Profile, not your website. A complete profile with 50+ photos and active engagement beats a thin profile with a better website almost every time."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"2. NAP consistency everywhere"}],["$","p",null,{"className":"mb-4","children":"NAP = Name, Address, Phone. Pick one canonical version (especially for the phone — formatted exactly the same way) and use it everywhere. Your website footer, your Google Business Profile, Yelp, Facebook, BBB, every local directory. Inconsistencies confuse Google and dilute your local relevance signal."}],["$","p",null,{"className":"mb-4","children":"Run a quick audit: search Google for your business name and click through to every listing you find. Note any address, phone, or business name variations. Fix them."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"3. Build a real review pipeline"}],["$","p",null,{"className":"mb-4","children":["Reviews are the second-biggest local ranking factor after Google Business Profile completeness. The trick isn't getting a big batch of reviews once — it's getting reviews ",["$","em",null,{"children":"consistently"}],". Google's algorithm cares about recency."]}],["$","p",null,{"className":"mb-4","children":"Practical approach: a one-line text message to satisfied customers a day after the job is done, with a direct link to your Google review form. Conversion rate from \"ask\" to \"review\" is typically 15–30% with a direct link, vs <5% if you make them search for you."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"4. One page per service, one page per location"}],["$","p",null,{"className":"mb-4","children":"If you do five services in three cities, that's potentially 15 pages — one for each service in each city. This is not \"spammy SEO\" — it's how Google understands which service you do in which place. The pages should be substantively different, not copy-pasted with the city name swapped."}],["$","p",null,{"className":"mb-4","children":"A roofer in Boston shouldn't have just a Services page. They should have separate pages for residential roofing in Boston, commercial roofing in Boston, roof repair in Boston, plus a page each for any other cities they serve. Each page targets a different keyword combination."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"5. Schema markup for local business"}],["$","p",null,{"className":"mb-4","children":"Add LocalBusiness JSON-LD to every page on your site (or at minimum the homepage). This tells Google explicitly: this is a business, here's the type, here's the address, here's the phone number, here are the hours, here are the services. Schema doesn't directly boost rankings, but it makes you eligible for rich results (the fancy listings with stars, hours, and call buttons in search results)."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"6. Page speed (yes, again)"}],["$","p",null,{"className":"mb-4","children":["Your site needs to load fast on mobile. Run ",["$","a",null,{"href":"https://pagespeed.web.dev","target":"_blank","rel":"noopener","className":"text-blue-600 hover:underline","children":"PageSpeed Insights"}]," on your homepage. Aim for 80+ mobile. If you're below 60, you're being actively penalized. The biggest culprits: unoptimized images, slow hosting, and bloated theme/page-builder code."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"7. Local link building"}],["$","p",null,{"className":"mb-4","children":"A link from your local chamber of commerce, a local newspaper, or a topically-relevant local nonprofit you sponsor is worth more for local SEO than a link from a generic national directory. Aim for:"}],["$","ul",null,{"className":"list-disc pl-6 mb-4 space-y-2","children":[["$","li",null,{"children":"Chamber of commerce membership listing"}],["$","li",null,{"children":"Local industry association directory"}],["$","li",null,{"children":"Local sponsorships (Little League, community events, charity)"}],["$","li",null,{"children":"Press from any local newspaper or blog you can get"}]]}],["$","p",null,{"className":"mb-4","children":"Skip the spammy directory sites that email you. They don't help."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"8. Content that answers local questions"}],["$","p",null,{"className":"mb-4","children":"For every service you offer, write at least one blog post that answers a question people actually ask. \"How much does drywall cost in [city]?\" \"What permits do I need to remodel a kitchen in [state]?\" These pages intercept high-intent traffic."}],["$","p",null,{"className":"mb-4","children":["If you sell a service where customers do math before buying, build a calculator. See"," ",["$","a",null,{"href":"https://remodelcalculators.com","target":"_blank","rel":"noopener","className":"text-blue-600 hover:underline","children":"RemodelCalculators"}]," ","and"," ",["$","a",null,{"href":"https://rightdumpster.com","target":"_blank","rel":"noopener","className":"text-blue-600 hover:underline","children":"RightDumpster"}]," ","as examples of how interactive tools rank and convert in service categories."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"9. Track everything"}],["$","p",null,{"className":"mb-4","children":"Set up Google Analytics and Google Search Console. Check Search Console at least monthly to see which queries you're ranking for, which pages are getting impressions but few clicks (these are titles + descriptions that need rewriting), and which pages have indexing issues."}],["$","p",null,{"className":"mb-4","children":"Without tracking you're guessing. With tracking you're making decisions."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"10. Be patient, then audit"}],["$","p",null,{"className":"mb-4","children":"Local SEO results compound over 3–9 months. Don't redo everything every two weeks because you're not yet on page 1. Implement the checklist, give it a quarter, then audit what worked and what didn't."}],["$","p",null,{"className":"mb-4","children":"The boring fundamentals beat 90% of the shiny tactics. If you do this checklist properly you'll outrank most local competitors who are paying for trendier SEO advice."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"The 90/10 version"}],["$","p",null,{"className":"mb-4","children":"If you can only do three things this month:"}],["$","ol",null,{"className":"list-decimal pl-6 mb-4 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Complete your Google Business Profile"}]," — every field, 30+ photos."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Set up a review request workflow"}]," — text customers with a direct link the day after the job."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Make sure NAP is consistent"}]," across your top 10 listings."]}]]}],["$","p",null,{"className":"mb-4","children":"That's 80% of the local SEO benefit for 20% of the work."}],["$","p",null,{"className":"mb-4","children":["This is the same checklist I run on my own sites before reaching for anything fancier. If you're working through it on a project of your own and want to compare notes, ",["$","a",null,{"href":"/#contact","className":"text-blue-600 hover:underline","children":"say hi"}],"."]}]]}],["$","div",null,{"className":"mt-16 p-8 bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl text-center","children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"More from the workshop"}],["$","p",null,{"className":"text-gray-600 mb-6 max-w-xl mx-auto","children":"I build and operate a portfolio of niche websites and interactive tools — and write the build log behind each one. Browse the rest of the projects and notes."}],["$","$L3",null,{"href":"/#portfolio","className":"inline-block bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-3 rounded-full font-semibold hover:shadow-lg transition-shadow","children":"See the projects →"}]]}]]}],["$","section",null,{"className":"mt-20 pt-12 border-t border-gray-200","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-8","children":"More from the blog"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-8","children":[["$","$L3","behind-the-build-figuremoney",{"href":"/blog/behind-the-build-figuremoney/","className":"group","children":[["$","div",null,{"className":"text-xs text-gray-500 mb-2","children":"July 13, 2026"}],["$","h3",null,{"className":"text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2","children":"Behind the Build: FigureMoney and Ranking in a YMYL Niche"}],["$","p",null,{"className":"text-gray-600 text-sm","children":"Personal finance is the hardest niche on the internet to rank and get ad-approved in. Here is how FigureMoney — a 25-calculator suite — was built to earn trust: show every formula, cite every source, and cover paycheck taxes state by state."}]]}],["$","$L3","build-log-225-diagrams-remodelcalculators",{"href":"/blog/build-log-225-diagrams-remodelcalculators/","className":"group","children":[["$","div",null,{"className":"text-xs text-gray-500 mb-2","children":"July 8, 2026"}],["$","h3",null,{"className":"text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2","children":"Build Log: Why I Made 225 Original Diagrams for One Calculator Site"}],["$","p",null,{"className":"text-gray-600 text-sm","children":"Why I drew 225 original, labeled construction diagrams for RemodelCalculators — the EEAT case for original illustrations, and how each one doubles as a Pinterest distribution asset."}]]}]]}]]}]]}],["$","footer",null,{"className":"bg-gray-900 text-white py-12 mt-20","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center","children":[["$","$L3",null,{"href":"/","className":"inline-flex items-center justify-center mb-6","children":[["$","img",null,{"src":"/logo1.png","alt":"Modern Site Builders","className":"w-10 h-10 object-contain"}],["$","span",null,{"className":"ml-3 text-xl font-bold","children":"Modern Site Builders"}]]}],["$","p",null,{"className":"text-gray-400 mb-4","children":"Building and operating useful internet businesses in public."}],["$","p",null,{"className":"text-gray-500 text-sm mb-2","children":"© 2026 Modern Site Builders. Built by David Miles."}],["$","$L3",null,{"href":"/privacy","className":"text-gray-400 hover:text-white text-sm transition-colors inline-block","children":"Privacy Policy"}]]}]}]]}]],null],null]},["$","$L4",null,{"parallelRouterK