dernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://promptdynamo.com/#website","name":"PromptDynamo","url":"https://promptdynamo.com","description":"Done-for-you AI prompt packs for working professionals.","sameAs":["https://www.facebook.com/profile.php?id=61588539059595"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}},{"@type":"WebSite","@id":"https://figuremoney.com/#website","name":"FigureMoney","url":"https://figuremoney.com","description":"Personal-finance calculators that show the formula and sources behind every result.","sameAs":["https://www.facebook.com/profile.php?id=61592035468967"],"publisher":{"@id":"https://modernsitebuilders.com/#organization"}}]}0:["6X-03Igl0yPGYem6o6cli",[[["",{"children":["blog",{"children":[["slug","behind-the-build-figuremoney","d"],{"children":["__PAGE__?{\"slug\":\"behind-the-build-figuremoney\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","behind-the-build-figuremoney","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"min-h-screen bg-white","children":[["$","$L2",null,{"id":"article-schema-behind-the-build-figuremoney","type":"application/ld+json","children":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Behind the Build: FigureMoney and Ranking in a YMYL Niche\",\"description\":\"Personal finance is the hardest niche on the internet to rank and get ad-approved in. Here is how FigureMoney — a 25-calculator suite — was built to earn trust: show every formula, cite every source, and cover paycheck taxes state by state.\",\"datePublished\":\"2026-07-13\",\"dateModified\":\"2026-07-13\",\"author\":{\"@type\":\"Person\",\"name\":\"David Miles\"},\"publisher\":{\"@id\":\"https://modernsitebuilders.com/#organization\"},\"image\":\"https://modernsitebuilders.com/Screenshot-figuremoney.jpg\",\"mainEntityOfPage\":\"https://modernsitebuilders.com/blog/behind-the-build-figuremoney/\",\"keywords\":\"Case Study, SEO\"}"}],["$","header",null,{"className":"border-b border-gray-200","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-between","children":[["$","$L3",null,{"href":"/","className":"flex items-center hover:opacity-80 transition-opacity","children":[["$","img",null,{"src":"/logo1.png","alt":"Modern Site Builders","className":"w-10 h-10 object-contain"}],["$","span",null,{"className":"ml-3 text-xl font-bold text-gray-900","children":"Modern Site Builders"}]]}],["$","$L3",null,{"href":"/#portfolio","className":"text-gray-700 hover:text-blue-600 text-sm font-semibold transition-colors","children":"Projects"}]]}]}],["$","main",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16","children":[["$","nav",null,{"className":"mb-8 text-sm text-gray-500","children":[["$","$L3",null,{"href":"/","className":"hover:text-blue-600","children":"Home"}],["$","span",null,{"className":"mx-2","children":"›"}],["$","$L3",null,{"href":"/blog/","className":"hover:text-blue-600","children":"Blog"}]]}],["$","article",null,{"children":[["$","header",null,{"className":"mb-10","children":[["$","div",null,{"className":"flex items-center gap-3 text-sm text-gray-500 mb-4","children":[["$","time",null,{"dateTime":"2026-07-13","children":"July 13, 2026"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":[8," min read"]}],[["$","span",null,{"children":"·"}],["$","span",null,{"children":"Case Study · SEO"}]]]}],["$","h1",null,{"className":"text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight","children":"Behind the Build: FigureMoney and Ranking in a YMYL Niche"}],["$","p",null,{"className":"text-sm text-gray-500","children":["By ",["$","$L3",null,{"href":"/author/david-miles","className":"text-blue-600 hover:text-blue-800 font-medium","children":"David Miles"}]]}]]}],["$","div",null,{"className":"prose-content text-gray-800 leading-relaxed","children":[["$","p",null,{"className":"text-xl text-gray-600 mb-8 leading-relaxed","children":["Personal finance is the single hardest niche on the internet to rank in. Google files it under YMYL — \"Your Money or Your Life\" — the category it holds to the highest trust bar, because a wrong number can cost a reader real money. AdSense scrutinizes finance pages harder than almost anything else before it will run ads on them."," ",["$","a",null,{"href":"https://figuremoney.com","target":"_blank","rel":"noopener","className":"text-blue-600 hover:underline","children":"FigureMoney"}]," ","was built to clear that bar on purpose, and the decisions behind it are a useful case study in earning trust when the algorithm assumes you haven't."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"Why a finance calculator is the hardest thing to rank"}],["$","p",null,{"className":"mb-4","children":"Most calculator sites in this space are a thin input box wrapped in ads. They give you a monthly payment with no explanation of how they got there, no sources, and no way to check the math. For a low-stakes topic that's fine. For a mortgage, a 401(k), or a paycheck, it isn't — and Google's quality systems know the difference."}],["$","p",null,{"className":"mb-4","children":["So the first design principle for FigureMoney wasn't \"add more calculators.\" It was ",["$","em",null,{"children":"show your work"}],". Every result has to come with the formula that produced it, the constants it used, and the authoritative source those constants came from. That single constraint shaped the entire build."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"The \"show your work\" architecture"}],["$","p",null,{"className":"mb-4","children":"Every calculator page carries two trust layers that most competitors skip:"}],["$","ul",null,{"className":"list-disc pl-6 mb-4 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"A methodology block"}]," that publishes the exact formula, the constants, and the source behind the number — so a reader (or a search-quality rater, or an ad reviewer) can verify the result instead of taking it on faith."]}],["$","li",null,{"children":[["$","strong",null,{"children":"An industry-standards block"}]," that names the actual regulations and standards a calculation is based on — IRS contribution limits, RMD rules, standard amortization — the E-E-A-T signal that says a real, informed operator built this."]}]]}],["$","p",null,{"className":"mb-4","children":["One detail that mattered more than it looks: the methodology content is always in the page's HTML, even when it's visually collapsed. It's hidden with CSS, not removed from the DOM. Crawlers see the full explanation on every page whether or not a human expands it — you get the clean UI ",["$","em",null,{"children":"and"}]," the crawlable depth, instead of trading one for the other."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"Programmatic SEO: paychecks, state by state"}],["$","p",null,{"className":"mb-4","children":"Take-home pay is one of the highest-intent searches in personal finance, and it's inherently local — \"paycheck calculator\" means something different in Texas (no state income tax) than in California (nine brackets). Generic national calculators get this wrong, and searchers can tell."}],["$","p",null,{"className":"mb-4","children":"So FigureMoney generates a dedicated paycheck page for each state from a single 2026 tax dataset — 42 state landing pages, each with that state's real withholding rules, all driven off one data file rather than 42 hand-built pages. It's the same programmatic-SEO play behind the city pages on my other sites: one template, structured data, real per-location accuracy. Add a state's numbers to the dataset and its page builds itself."}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"One formula engine, 25 calculators"}],["$","p",null,{"className":"mb-4","children":"The suite is 25 calculators across seven clusters — Mortgage & Home, Auto, Investing, Retirement, Savings, Paycheck & Salary, and Loans & Debt. That range only works because the actual math lives in one place: a single finance library that every calculator imports from."}],["$","p",null,{"className":"mb-4","children":["Centralizing the logic isn't just tidy — in a YMYL niche it's the accuracy strategy. Amortization, compound interest, and effective-rate math get written and checked ",["$","em",null,{"children":"once"}],", then reused everywhere. There's no drift where the mortgage page and the auto-loan page disagree about how interest compounds, because they're calling the same function. When the trust pitch is \"our numbers are right,\" you cannot afford twenty-five slightly different implementations of the same formula."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"What I'd do differently"}],["$","p",null,{"className":"mb-4","children":"The biggest lesson is on the author signal. FigureMoney carries a \"Built by David Miles\" byline in the footer, linking back here — but its on-page structured data still credits the FigureMoney organization as the author, not the same David Miles person entity my other sites share. In a niche where E-E-A-T is the whole game, wiring a real, consistent author identity into the schema from day one is worth more than another calculator. That's the next fix."}],["$","p",null,{"className":"mb-4","children":["The other thing: I'd launch with the full methodology and source blocks populated on every page before the site went live, rather than treating them as something to backfill. In YMYL, the trust layer ",["$","em",null,{"children":"is"}]," the product — it shouldn't lag the calculators."]}],["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mt-12 mb-4","children":"Why this matters for your business"}],["$","p",null,{"className":"mb-4","children":["If you operate anywhere near a high-trust topic — health, money, legal, safety — the winning move is rarely more content. It's more ",["$","em",null,{"children":"verifiable"}]," content: show the formula, cite the source, name the standard, and make it all visible to both the reader and the crawler. Trust you can check ranks better than confidence you can't."]}],["$","p",null,{"className":"mb-4","children":["\"Does this category reward showing your work?\" is the question behind FigureMoney. The rest of the teardowns are in the ",["$","a",null,{"href":"/blog/","className":"text-blue-600 hover:underline","children":"build logs"}],"."]}]]}],["$","div",null,{"className":"mt-16 p-8 bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl text-center","children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"More from the workshop"}],["$","p",null,{"className":"text-gray-600 mb-6 max-w-xl mx-auto","children":"I build and operate a portfolio of niche websites and interactive tools — and write the build log behind each one. Browse the rest of the projects and notes."}],["$","$L3",null,{"href":"/#portfolio","className":"inline-block bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-3 rounded-full font-semibold hover:shadow-lg transition-shadow","children":"See the projects →"}]]}]]}],["$","section",null,{"className":"mt-20 pt-12 border-t border-gray-200","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-8","children":"More from the blog"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-8","children":[["$","$L3","build-log-225-diagrams-remodelcalculators",{"href":"/blog/build-log-225-diagrams-remodelcalculators/","className":"group","children":[["$","div",null,{"className":"text-xs text-gray-500 mb-2","children":"July 8, 2026"}],["$","h3",null,{"className":"text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2","children":"Build Log: Why I Made 225 Original Diagrams for One Calculator Site"}],["$","p",null,{"className":"text-gray-600 text-sm","children":"Why I drew 225 original, labeled construction diagrams for RemodelCalculators — the EEAT case for original illustrations, and how each one doubles as a Pinterest distribution asset."}]]}],["$","$L3","custom-business-website-cost-2026",{"href":"/blog/custom-business-website-cost-2026/","className":"group","children":[["$","div",null,{"className":"text-xs text-gray-500 mb-2","children":"June 3, 2026"}],["$","h3",null,{"className":"text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2","children":"How Much Does a Custom Business Website Cost in 2026?"}],["$","p",null,{"className":"text-gray-600 text-sm","children":"Straight-talk pricing for custom business websites in 2026 — from $500 starter sites to $15K+ tool-driven builds, with what you get at each tier."}]]}]]}]]}]]}],["$","footer",null,{"className":"bg-gray-900 text-white py-12 mt-20","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center","children":[["$","$L3",null,{"href":"/","className":"inline-flex items-center justify-center mb-6","children":[["$","img",null,{"src":"/logo1.png","alt":"Modern Site Builders","className":"w-10 h-10 object-contain"}],["$","span",null,{"className":"ml-3 text-xl font-bold","children":"Modern Site Builders"}]]}],["$","p",null,{"className":"text-gray-400 mb-4","children":"Building and operating useful internet businesses in public."}],["$","p",null,{"className":"text-gray-500 text-sm mb-2","children":"© 2026 Modern Site Builders. Built by David Miles."}],["$","$L3",null,{"href":"/privacy","className":"text-gray-400 hover:text-white text-sm transition-colors inline-block","children":"Privacy Policy"}]]}]}]]}]],null],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$",